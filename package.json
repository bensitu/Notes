{
  "name": "notes-docs-site",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build:site": "node scripts/build-site.mjs",
    "audit:site": "node scripts/audit-site.mjs",
    "validate:site": "node scripts/validate-site.mjs",
    "test:site": "node --test tests/site/*.test.mjs",
    "check:local-links": "node scripts/normalize-local-links.mjs",
    "test:site:browser": "playwright test -c tests/site/playwright.config.mjs",
    "serve:site": "node scripts/serve-site.mjs",
    "test:translations": "node --test tests/translation/*.test.mjs",
    "validate:translations": "node scripts/translation/validate.mjs",
    "translate:plan": "node scripts/translation/run.mjs --plan",
    "translate:run": "node scripts/translation/run.mjs",
    "translate:review": "node scripts/translation/review.mjs",
    "pretest:translations:browser": "node tests/translation/browser-fixture.mjs",
    "test:translations:browser": "playwright test -c tests/translation/playwright.config.mjs"
  },
  "dependencies": {
    "@babel/standalone": "8.1.1",
    "docsify": "5.1.0",
    "github-slugger": "2.0.0",
    "parse5": "8.0.0",
    "prismjs": "1.30.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "remark-stringify": "11.0.0",
    "unified": "11.0.5",
    "unist-util-visit": "5.1.0",
    "vue": "3.5.44",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "esbuild": "0.28.2"
  }
}
